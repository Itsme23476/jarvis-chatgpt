# Codex uses your saved ChatGPT login. Never add an OpenAI/Anthropic API key.
JARVIS_MODEL=gpt-6-astra
JARVIS_TIMEOUT=180
# CODEX_CMD=/absolute/path/to/codex
# JARVIS_WORKDIR=/absolute/path/to/working/folder

# Optional Fish Audio speech. Leave key empty to use the browser voice.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=drama-3
FISH_AUDIO_VOICE_ID=

# Offline listening with whisper.cpp and ffmpeg (English).
JARVIS_STT=auto
# WHISPER_BIN=/absolute/path/to/whisper-cli
# WHISPER_MODEL=~/.cache/whisper/ggml-base.bin
# FFMPEG_BIN=/absolute/path/to/ffmpeg

# Personal Markdown notes stay local and are ignored by Git.
# JARVIS_VAULT=/absolute/path/to/your/vault
JARVIS_PORT=8720
JARVIS_OPEN=1
